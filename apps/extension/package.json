{
	"name": "extension",
	"version": "0.0.0",
	"private": true,
	"description": "manifest.json description",
	"type": "module",
	"scripts": {
		"dev": "wxt --port 5555",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"postinstall": "wxt prepare"
	},
	"dependencies": {
		"@base-ui/react": "^1.3.0",
		"@pengana/api": "workspace:*",
		"@pengana/i18n": "workspace:*",
		"@pengana/env": "workspace:*",
		"@pengana/org": "workspace:*",
		"@pengana/sync": "workspace:*",
		"@pengana/local-db": "workspace:*",
		"@pengana/ui": "workspace:*",
		"zod": "catalog:",
		"@orpc/client": "catalog:",
		"@pengana/auth": "workspace:*",
		"dexie": "^4.4.1",
		"dexie-react-hooks": "^4.4.0",
		"lucide-react": "^1.7.0",
		"react": "catalog:",
		"react-dom": "catalog:",
		"shadcn": "^4.1.1",
		"tw-animate-css": "^1.2.5"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.2.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@wxt-dev/module-react": "^1.2.2",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"vite": "catalog:",
		"vitest": "catalog:",
		"wxt": "^0.20.20"
	}
}
